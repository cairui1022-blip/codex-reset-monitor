# ===== X / Twitter 采集 =====
# RSSHub 实例地址（可用公共实例或自建）
RSSHUB_BASE_URL=https://rsshub.app
TIBO_USERNAME=thsottiaux

# ===== 轮询 =====
POLL_INTERVAL_MIN=10

# ===== 数据库 =====
STORE_PATH=./data/app.db

# ===== Telegram（可选）=====
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===== PushPlus 微信推送 =====
# 系统级 PushPlus token（用于群发，需开通群组）
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=codex-reset   # 群组编码（可选）

# ===== 企业微信机器人（可选）=====
WECOM_WEBHOOK=

# ===== Server酱 兜底（可选）=====
SERVERCHAN_SENDKEY=

# ===== 短信推送（阿里云/腾讯云，可选）=====
# 如果未配置，手机号订阅者只通过微信渠道通知
SMS_PROVIDER=           # aliyun 或 tencent
# 阿里云
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SIGN_NAME=
ALIYUN_TEMPLATE_CODE=
# 腾讯云
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN=
TENCENT_SMS_TEMPLATE_ID=

# ===== Web 服务 =====
WEB_HOST=0.0.0.0
WEB_PORT=8000
API_SECRET=change-me-in-production

# ===== 代理（在国内部署时，用于访问 X/RSSHub）=====
HTTP_PROXY=
HTTPS_PROXY=
